{
  "name": "almasim-frontend",
  "version": "2.1.16",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "svelte-kit sync && vitest run",
    "test:e2e": "playwright test",
    "gen:api": "npx --yes openapi-typescript@7.13.0 src/lib/api/v2/openapi.json --default-non-nullable false -o src/lib/api/v2/schema.d.ts && prettier --write src/lib/api/v2/schema.d.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "fdir": {
      "picomatch": "4.0.4"
    },
    "chokidar": {
      "picomatch": "2.3.2"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "micromatch": {
      "picomatch": "2.3.2"
    }
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.17"
  }
}
